# Copy to .env (gitignored) and fill in. Never commit .env.
# For Gmail, use an App Password (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=recipient@example.com
# Set to 1 to actually send emails from detect.py / the dashboard
EMAIL_ENABLED=0

# Dataset location (read in place, never copied into the repo)
SAFETYEYE_DATASET=C:/Users/acer/Desktop/DataSet/css-data
